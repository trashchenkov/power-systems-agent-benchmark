__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
build/
dist/
*.egg-info/

# Hidden benchmark material must not be committed accidentally.
hidden/
**/hidden/

# Local investigation/source corpora can be very large; keep curated docs only.
literature/local_archive_extracted/
literature/local_archive_intake/
literature/raw_gdrive_*/
literature/curated_drive_corpus/

# Local submissions/results.
submissions/
results/

# Hidden-case packets contain the hidden tasks themselves; keep them local.
runs/agent_packets/hidden_*/
runs/agent_packets/canonical_hidden/

# Agent run logs are large/auxiliary; keep machine-readable results, not raw logs.
runs/canonical_round1/*/logs/

# Hidden-case run artifacts leak the oracle answers; keep only aggregate summary.json.
runs/canonical_round1/*-hidden/submissions/
runs/canonical_round1/*-hidden/results.jsonl
runs/canonical_round1/*-frt-rerun/submissions/
runs/canonical_round1/*-frt-rerun/results.jsonl

runs/agent_packets/canonical_frt_rerun/
runs/agent_packets/canonical_public/
