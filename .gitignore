__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
build/
dist/
*.egg-info/

# Hidden benchmark material must not be committed accidentally.
hidden/
**/hidden/

# Local investigation/source corpora can be very large; keep curated docs only.
literature/local_*/
literature/raw_gdrive_*/
literature/curated_drive_corpus/

# Local submissions/results.
submissions/
results/

# Generated run artifacts. Keep raw development runs local.
runs/agent_packets/
runs/public_agent_smoke/
runs/hidden_agent_smoke/
runs/**/logs/
runs/**/submissions/
runs/**/results.jsonl
runs/canonical_round1/*-frt-rerun/

# Curated public evidence that supports the paper. Hidden per-case artifacts remain ignored.
!runs/canonical_round1/*-public/results.jsonl
!runs/canonical_round1/*-public/submissions/
!runs/canonical_round1/*-public/submissions/*.json
!runs/canonical_round1/*-public/logs/
!runs/canonical_round1/*-public/logs/*.txt
!runs/extra_models/*/results.jsonl
!runs/extra_models/*/submissions/
!runs/extra_models/*/submissions/*.json
!runs/public_baselines/latest/results.jsonl

# Local baseline output may be regenerated; commit only curated files above.
runs/public_baselines/*/submissions/

# macOS local metadata.
.DS_Store
**/.DS_Store
