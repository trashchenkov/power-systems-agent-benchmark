{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/power-systems-agent-benchmark/task.schema.json",
  "title": "Power Systems Agent Benchmark Task",
  "type": "object",
  "required": [
    "task_id",
    "family",
    "substrate",
    "objective",
    "public_inputs",
    "submission_schema",
    "hard_constraints",
    "metrics",
    "source_evidence",
    "source_provenance"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "family": {"type": "string", "minLength": 1},
    "substrate": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "public_inputs": {"type": "object"},
    "submission_schema": {"type": "object"},
    "hard_constraints": {
      "type": "array",
      "items": {"type": "string"}
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "direction", "description"],
        "properties": {
          "name": {"type": "string"},
          "direction": {"enum": ["minimize", "maximize", "target", "boolean"]},
          "description": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "source_evidence": {
      "type": "array",
      "items": {"type": "string"}
    },
    "source_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "locator", "confidence", "notes"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "confidence": {"type": "string", "minLength": 1},
          "notes": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
