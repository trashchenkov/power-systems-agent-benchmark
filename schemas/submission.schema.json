{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/power-systems-agent-benchmark/submission.schema.json",
  "title": "Generic Power Systems Agent Benchmark Submission",
  "type": "object",
  "properties": {
    "actions": {
      "description": "Family-specific structured actions. Can be an object keyed by component/bus id or a list of action records.",
      "oneOf": [
        {"type": "object"},
        {"type": "array", "items": {"type": "object"}}
      ]
    },
    "answer": {
      "description": "Family-specific structured final answer for non-action tasks such as ranking, classification, or reliability calculation.",
      "type": ["object", "array", "string", "number", "boolean", "null"]
    },
    "rationale": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {"type": "string"},
          "source": {"type": "string"},
          "tool_call_id": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "anyOf": [
    {"required": ["actions"]},
    {"required": ["answer"]}
  ],
  "additionalProperties": true
}
