{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/power-systems-agent-benchmark/evaluation-result.schema.json",
  "title": "Power Systems Agent Benchmark Evaluation Result",
  "type": "object",
  "required": ["task_id", "feasible", "score", "violations"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "family": {"type": "string"},
    "feasible": {"type": "boolean"},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "violations": {
      "type": "array",
      "items": {"type": "string"}
    },
    "metrics": {"type": "object"},
    "evidence": {"type": "object"}
  },
  "additionalProperties": true
}
